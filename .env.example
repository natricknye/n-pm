# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# GitHub
GITHUB_USERNAME=natricknye
# Fine-grained PAT: Metadata read + Contents read (and repo access for private repos)
GITHUB_TOKEN=
# Secret used by GitHub webhooks (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=

# App auth
# Generate with: npm run hash-password
PM_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
PM_SESSION_SECRET=
# Optional: Vercel Cron Authorization bearer
CRON_SECRET=

# Public origin, used for same-origin checks
PM_SITE_URL=https://pm.natricknye.cn
